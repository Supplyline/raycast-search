{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "search-supplyline",
  "title": "Search Supplyline",
  "description": "Search Supplyline products, SKUs, and documentation via Algolia",
  "icon": "extension-icon.png",
  "author": "supplyline",
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Search Supplyline",
      "subtitle": "Products and SKUs",
      "description": "Search across Supplyline products and SKUs",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "showPrices",
      "title": "Show Prices",
      "description": "Display prices in search results",
      "type": "checkbox",
      "required": false,
      "default": true,
      "label": "Show prices in results"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.91.2",
    "@raycast/utils": "^1.17.0",
    "algoliasearch": "^5.47.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "^20.11.19",
    "@types/react": "18.3.3",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  }
}
